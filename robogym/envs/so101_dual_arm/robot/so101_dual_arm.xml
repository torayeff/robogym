<?xml version="1.0" encoding="utf-8"?>
<mujoco model="so101_dual_arm">
  <!-- Dual-arm mounting rig with an overhead camera; attaches so101.xml for each arm. -->
  <compiler angle="radian" meshdir="assets" />
  <default>
    <default class="robot">
      <geom friction="0.5 0.005 0.0001" condim="4" solref="0.006 1" solimp="0.95 0.99 0.001" />
      <default class="robot_visual">
        <geom type="mesh" material="3d_printed" contype="0" conaffinity="0" group="2" />
      </default>
      <default class="robot_collision">
        <geom type="box" group="3" mass="0" />
      </default>
    </default>
  </default>
  <asset>
    <material name="3d_printed" rgba="0.92 0.92 0.92 1" roughness="0.62" />
    <mesh file="arm_base.stl" scale="0.001 0.001 0.001" />
    <mesh file="cam_mount_bottom.stl" scale="0.001 0.001 0.001" />
    <mesh file="cam_mount_middle.stl" scale="0.001 0.001 0.001" />
    <mesh file="cam_mount_top.stl" scale="0.001 0.001 0.001" />
    <model name="so101" file="so101.xml" />
    <model name="u20cam" file="u20cam.xml" />
  </asset>
  <worldbody>
    <body name="rig_base" childclass="robot">
      <inertial pos="0.00337668 -9.90192e-07 0.217907" mass="0.3726" fullinertia="0.01301 0.01199 0.001156 -1.777e-09 0.0002446 -2.405e-08" />
      <!-- Printed parts in their CAD frames: visual meshes with their collision boxes. -->
      <frame pos="0.07522 0.0626 0.005" quat="0.707105482511 0.707108079859 0 0">
        <geom class="robot_visual" mesh="arm_base" />
        <geom name="left_mount_plate" class="robot_collision" pos="-0.049120915 -0.0014 -0.053430465" size="0.0448 0.0036 0.079519575" />
      </frame>
      <frame pos="0.07522 -0.16946 0.005" quat="0.707105482511 0.707108079859 0 0">
        <geom class="robot_visual" mesh="arm_base" />
        <geom name="right_mount_plate" class="robot_collision" pos="-0.049120915 -0.0014 -0.053430465" size="0.0448 0.0036 0.079519575" />
      </frame>
      <frame pos="-0.0187 0.03651 0" quat="0.707105482511 0.707108079859 0 0">
        <geom class="robot_visual" mesh="cam_mount_bottom" />
        <geom name="mast_foot" class="robot_collision" pos="0.0187 0.00435 0.0365125" size="0.0187 0.00435 0.0465125" />
        <geom name="mast_lower_post" class="robot_collision" pos="0.0187 0.119825 0.0365125" size="0.0127 0.111125 0.0183125" />
      </frame>
      <frame pos="0 0 0.1881" quat="0.707105482511 0.707108079859 0 0">
        <geom class="robot_visual" mesh="cam_mount_middle" />
        <geom class="robot_visual" mesh="cam_mount_top" />
        <geom name="mast_middle_post" class="robot_collision" pos="0 0.116425 -0.0000005" size="0.0127 0.081425 0.018312" />
        <geom name="mast_upper_post" class="robot_collision" pos="0 0.27216 -0.0000005" size="0.0127 0.08216 0.018312" />
        <geom name="mast_camera_plate" class="robot_collision" pos="0.027 0.36273 0" size="0.0195 0.0015 0.0175" euler="0 0 0.436332313" />
      </frame>
      <frame pos="0.0294 0 0.5519" quat="0.842453655654 0 0.53876881691 0">
        <attach model="u20cam" body="camera" prefix="top_" />
      </frame>
      <frame pos="0.0028 0.11603 0.0074">
        <attach model="so101" body="base" prefix="left_" />
      </frame>
      <frame pos="0.0028 -0.11603 0.0074">
        <attach model="so101" body="base" prefix="right_" />
      </frame>
    </body>
  </worldbody>
</mujoco>
